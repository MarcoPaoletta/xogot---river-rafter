[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true

[physics]

common/physics_jitter_fix=0
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55, 0.78, 0.92, 1)

[xogot]

project/editorState=[]
project/shaderEditorState=[]
project/breakpoints={}
project/disabled_breakpoints={}
